{
  "context-graph-continuity": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./bin/context-graph-engine hook antigravity local-context",
        "timeout": 12
      },
      {
        "type": "command",
        "command": "./bin/context-graph-engine hook antigravity context-continuity",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "./bin/context-graph-engine hook antigravity working-memory-read",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "./bin/context-graph-engine hook antigravity context-continuity",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./bin/context-graph-engine hook antigravity working-memory-write",
        "timeout": 12
      },
      {
        "type": "command",
        "command": "./bin/context-graph-engine hook antigravity context-continuity",
        "timeout": 12
      }
    ]
  }
}
